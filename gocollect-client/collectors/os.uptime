#!/bin/sh
# vim: set ts=8 sw=4 sts=4 et ai:
# REQUIRES: coreutils(date)
# REQUIRES: awk(awk)

get_t0() {
    NOW=$(date +%s.%N) LC_ALL=C awk '{
        printf "%d\n", ENVIRON["NOW"] - $1 + 0.5
    }' /proc/uptime
}

t0=$(LC_ALL=C get_t0)
d0=$(TZ=UTC LC_ALL=C date --date @$t0 --rfc-2822)
echo "{\"unixtime\":\"$t0\",\"rfc2822\":\"$d0\"}"
